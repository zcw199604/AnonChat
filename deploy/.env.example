# AnonChat 生产环境变量示例。复制为 deploy/.env 并填写真实值；.env 不入库。
# 注意：不要在此文件写入任何真实密钥。

# ---- 运行环境 ----
# development | test | production
APP_ENV=production

# ---- 站点与证书（web/Caddy）----
# 域名时自动申请 HTTPS；填 ":80" 表示前面有负载均衡，仅做反向代理
SITE_ADDRESS=anonchat.example.com
# 信任的上游代理（决定是否采信 X-Forwarded-For）。
# 留空 = 不信任任何上游（直接对公网暴露时安全，防伪造 XFF）。
# 当前面有负载均衡/CDN 时设为 private_ranges（或具体 CIDR，空格分隔），否则按 IP 的限流/封禁会失效。
UPSTREAM_TRUSTED_PROXIES=
# ACME（Let's Encrypt）通知邮箱
ACME_EMAIL=admin@example.com

# ---- 数据库 ----
# 必填：postgres 容器密码（compose 会据此拼出 DATABASE_URL）
POSTGRES_PASSWORD=change-me-strong-password

# ---- 安全 / 来源 ----
# 允许的前端 Origin，逗号分隔（生产必填）
ALLOWED_ORIGINS=https://anonchat.example.com
# 管理后台 IP 白名单（CIDR，逗号分隔；留空表示不限制）
ADMIN_IP_ALLOWLIST=
# 把所有限流上限乘以该系数；生产环境必须为 1
RATE_LIMIT_MULTIPLIER=1

# ---- 实名验证 ----
# off | optional | required
VERIFICATION_MODE=off
# 短信服务商：生产禁止 console；接入真实服务商后填写其名称及密钥
# 仅在 VERIFICATION_MODE≠off 时需要真实服务商，此时生产环境禁止 console。
# off 模式下可用默认 console（不会发送短信）；启用实名验证前须实现所选服务商（任务 5.x）。
SMS_PROVIDER=console
# 以真实服务商为例（按所选服务商填写，此处仅示意变量名）：
# SMS_ACCESS_KEY_ID=
# SMS_ACCESS_KEY_SECRET=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_CODE=
# 手机号加密与去重密钥（32 字节 base64）。生成方式：openssl rand -base64 32
# PHONE_ENC_KEY=
# PHONE_HMAC_KEY=

# ---- 内容安全 ----
# 敏感词库路径（compose 固定挂载到此处；生产必填）
# WORDLIST_PATH=/etc/anonchat/wordlist/words.txt

# ---- 数据保留期 ----
MESSAGE_RETENTION=168h
AUDIT_RETENTION=4320h
BOTTLE_TTL=168h
RETENTION_INTERVAL=10m

# ---- 匹配 ----
MATCH_RELAX_AFTER=15s
MATCH_GRACE=30s

# ---- AI 机器人（Bot，how.md §2、§15）----
# 重要：以下 bot 相关变量只用于「首次初始化」——服务第一次启动时写入数据库表 bot_settings。
# 之后以管理后台「Bot → 全局设置」里的值为准，环境变量不再生效（无需重启即可热切换）。
# 管理后台可修改：总开关、Base URL、模型、API Key、超时、prompt_cache_key 开关、
# 匹配兜底时间、漂流瓶最短瓶龄、时区。
# 是否启动 bot 引擎（首次初始化时是否默认打开总开关）。
BOT_ENABLED=false
# OpenAI 兼容接口地址（不带 /chat/completions），例如：
#   https://api.openai.com/v1 | https://api.deepseek.com/v1 | https://openrouter.ai/api/v1
LLM_BASE_URL=https://api.openai.com/v1
# BOT_ENABLED=true 时必填
LLM_API_KEY=
# 默认模型（单个 bot 可以覆盖）。可在后台补填，因此不是启动必填项
LLM_MODEL=
# 单次模型请求超时
LLM_TIMEOUT=60s
# 是否在请求里带 prompt_cache_key（服务商拒绝未知参数时设为 false）
LLM_SEND_CACHE_KEY=true
# 排队多久仍无真人配对时由 bot 兜底
BOT_MATCH_FALLBACK_AFTER=10s
# 瓶子投出多久仍没人回复，bot 才会去回
BOT_BOTTLE_MIN_AGE=30m
# 提示词里显示当前时间用的时区
BOT_TIMEZONE=Asia/Shanghai

# ---- 后台敏感配置的加密密钥（how.md §15.1）----
# 用于加密后台保存的模型 API Key（AES-256-GCM，32 字节）。生成：openssl rand -base64 32
# 不配置时后台不能保存 API Key（其余设置照常可保存），但可以继续用 LLM_API_KEY。
# 配置后请离线备份：丢失将无法解密已保存的 key，需要重新在后台填写。
SETTINGS_ENC_KEY=

# ---- 媒体库（how.md §4）----
# 媒体文件根目录（compose 已挂载 media 卷到 /data/media，会覆盖此处默认值）
MEDIA_ROOT=./data/media
# 单个媒体文件大小上限（MB）；单次上传请求体上限为其 10 倍
MEDIA_MAX_UPLOAD_MB=100
