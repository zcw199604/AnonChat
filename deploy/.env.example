# AnonChat 生产环境变量示例。复制为 deploy/.env 并填写真实值；.env 不入库。
# 注意：不要在此文件写入任何真实密钥。
# 外站接入方案：../helloagents/main/plan/202611131925_external-match-bridge/how.md

# ---- 运行环境 ----
# development | test | production
APP_ENV=production

# ---- 站点与证书（web/Caddy）----
# 域名时自动申请 HTTPS；填 ":80" 表示前面有负载均衡，仅做反向代理
SITE_ADDRESS=anonchat.example.com
# 信任的上游代理（决定是否采信 X-Forwarded-For）。
# 留空 = 不信任任何上游（直接对公网暴露时安全，防伪造 XFF）。
# 当前面有负载均衡/CDN 时设为 private_ranges（或具体 CIDR，空格分隔），否则按 IP 的限流/封禁会失效。
UPSTREAM_TRUSTED_PROXIES=
# ACME（Let's Encrypt）通知邮箱
ACME_EMAIL=admin@example.com

# ---- 数据库 ----
# 必填：postgres 容器密码（compose 会据此拼出 DATABASE_URL）
POSTGRES_PASSWORD=change-me-strong-password

# ---- 安全 / 来源 ----
# 允许的前端 Origin，逗号分隔（生产必填）
ALLOWED_ORIGINS=https://anonchat.example.com
# 管理后台 IP 白名单（CIDR，逗号分隔；留空表示不限制）
ADMIN_IP_ALLOWLIST=
# 把所有限流上限乘以该系数；生产环境必须为 1
RATE_LIMIT_MULTIPLIER=1

# ---- 实名验证 ----
# off | optional | required
VERIFICATION_MODE=off
# 短信服务商：生产禁止 console；接入真实服务商后填写其名称及密钥
# 仅在 VERIFICATION_MODE≠off 时需要真实服务商，此时生产环境禁止 console。
# off 模式下可用默认 console（不会发送短信）；启用实名验证前须实现所选服务商（任务 5.x）。
SMS_PROVIDER=console
# 以真实服务商为例（按所选服务商填写，此处仅示意变量名）：
# SMS_ACCESS_KEY_ID=
# SMS_ACCESS_KEY_SECRET=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_CODE=
# 手机号加密与去重密钥（32 字节 base64）。生成方式：openssl rand -base64 32
# PHONE_ENC_KEY=
# PHONE_HMAC_KEY=

# ---- 内容安全 ----
# 敏感词库路径（compose 固定挂载到此处；生产必填）
# WORDLIST_PATH=/etc/anonchat/wordlist/words.txt

# ---- 数据保留期 ----
MESSAGE_RETENTION=168h
AUDIT_RETENTION=4320h
BOTTLE_TTL=168h
RETENTION_INTERVAL=10m

# ---- 匹配 ----
MATCH_RELAX_AFTER=15s
MATCH_GRACE=30s

# ---- AI 机器人（Bot，how.md §2、§15）----
# 重要：以下 bot 相关变量只用于「首次初始化」——服务第一次启动时写入数据库表 bot_settings。
# 之后以管理后台「Bot → 全局设置」里的值为准，环境变量不再生效（无需重启即可热切换）。
# 管理后台可修改：总开关、Base URL、模型、API Key、超时、prompt_cache_key 开关、
# 匹配兜底时间、漂流瓶最短瓶龄、时区。
# 是否启动 bot 引擎（首次初始化时是否默认打开总开关）。
BOT_ENABLED=false
# OpenAI 兼容接口地址（不带 /chat/completions），例如：
#   https://api.openai.com/v1 | https://api.deepseek.com/v1 | https://openrouter.ai/api/v1
LLM_BASE_URL=https://api.openai.com/v1
# BOT_ENABLED=true 时必填
LLM_API_KEY=
# 默认模型（单个 bot 可以覆盖）。可在后台补填，因此不是启动必填项
LLM_MODEL=
# 单次模型请求超时
LLM_TIMEOUT=60s
# 是否在请求里带 prompt_cache_key（服务商拒绝未知参数时设为 false）
LLM_SEND_CACHE_KEY=true
# 排队多久仍无真人配对时由 bot 兜底
BOT_MATCH_FALLBACK_AFTER=10s
# 瓶子投出多久仍没人回复，bot 才会去回
BOT_BOTTLE_MIN_AGE=30m
# 提示词里显示当前时间用的时区
BOT_TIMEZONE=Asia/Shanghai

# ---- 后台敏感配置的加密密钥（how.md §15.1）----
# 用于加密后台保存的模型 API Key 和晚风账号 token（secretbox 辅助包，AES-256-GCM，32 字节）。
# 生成：openssl rand -base64 32；晚风缺少此密钥时不可用。
# 不配置时后台不能保存 API Key（其余设置照常可保存），但可以继续用 LLM_API_KEY。
# 配置后请离线备份：丢失将无法解密已保存的 key 和晚风账号 token。
SETTINGS_ENC_KEY=

# ---- 媒体库（how.md §4）----
# 媒体文件根目录（compose 已挂载 media 卷到 /data/media，会覆盖此处默认值）
MEDIA_ROOT=./data/media
# 单个媒体文件大小上限（MB）；单次上传请求体上限为其 10 倍
MEDIA_MAX_UPLOAD_MB=100

# ---- 用户媒体与外站（00010；详见同目录 README 第 9 节）----
# 总开关、两站开关及匹配时机/连接上限由数据库 external_settings 和后台「外站接入」控制。
# 首次默认全部关闭；不存在 EXTERNAL_ENABLED 环境变量。
# 用户上传单个文件上限（正整数 MB）；仅 match/bottle/private 支持用户发图片/视频。
USER_MEDIA_MAX_UPLOAD_MB=20
# 服务端外站 HTTP 请求超时（正整数秒；不是外站匹配时长）。
EXTERNAL_TIMEOUT_SECONDS=30
# chat2019 始终直连，禁止重定向。下面是当前默认地址；不需要额外填写用户 IP/地址。
EXTERNAL_CHAT2019_RAND_SERVER_URL=http://v1.chat2019.cn/Act/WebService.asmx/getRandServer?ServerInfo=serversdeskry&_=
# 发现服务失败时使用的 ws:// 或 wss:// 地址；默认空，不猜测备用站点。
EXTERNAL_CHAT2019_FALLBACK_WS=
EXTERNAL_CHAT2019_IMG_SERVER_URL=http://v1.chat2019.cn/asmx/method.asmx/getImgServer
EXTERNAL_WANFENG_BASE_URL=https://wanfengniming.store
# 默认按 BaseURL + 协议 WSPath（默认 /ws）推导；显式配置必须是 ws:// 或 wss://。
EXTERNAL_WANFENG_WS_URL=
# 晚风出口代理，可选 http://、https://、socks5:// URL。留空直连；只支持单一普通代理。
EXTERNAL_WANFENG_HTTP_PROXY=
# Protocol 字段覆盖，非空必须是合法 JSON，字段类型还会在客户端装配时校验。
EXTERNAL_WANFENG_PROTOCOL_OVERRIDES=
# 全进程新晚风账号注册令牌桶（正整数/小时）；复用已有账号不消耗。
EXTERNAL_WANFENG_NEW_IDENTITY_PER_HOUR=10
# 媒体主机名白名单，逗号分隔，不填 URL/路径；留空默认 BaseURL 主机。
# HTTP/WS 的总白名单还会合并 BaseURL 主机和显式 WSURL 主机。
# 代理侧 DNS 不能由本机约束，只应填写可信公网域名，见 README 的剩余风险说明。
EXTERNAL_WANFENG_MEDIA_HOSTS=

# ---- 晚风 SCF 云函数隧道（可选；香港机房直连晚风会被阿里云 ESA WAF 拦截时使用）----
# 开启后晚风全部流量（握手、身份、历史/关系接口、图片/视频上传下载、WebSocket）都走腾讯云
# SCF 云函数 TCP 隧道；chat2019 不受影响，仍然直连。
# 与 EXTERNAL_WANFENG_HTTP_PROXY 互斥：两者同时配置会启动失败，只能留一个。
EXTERNAL_WANFENG_SCF_ENABLED=false
# 托管模式：由本服务用腾讯云凭证自动建池/补位/清理退役函数。需要先开 EXTERNAL_WANFENG_SCF_ENABLED。
# 会通过腾讯云 API 创建和删除计费云函数；首次建池可能需要数分钟（部署探活需留出时间）。
# 关闭托管时只复用已有池，仍支持封禁自动切换，但补位需要自行执行 scfproxy CLI。
SCFPROXY_MANAGED=false
# 出口池 pool.json 路径（compose 已挂载 scf 卷到 /data/scf，该目录需可写）。
SCFPROXY_POOL_FILE=/data/scf/pool.json
# SCF 隧道共享令牌，必须与云函数侧一致。生成方式：openssl rand -hex 32
SCFPROXY_TOKEN=
# 托管模式使用的腾讯云凭证（建议用子账号并只授予 SCF 管理权限；长期凭证无需 SESSION_TOKEN）。
# 只经环境变量传入子进程，不进入命令行参数、池文件或日志。
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
# 可选：临时凭证的会话 Token。
# TENCENTCLOUD_SESSION_TOKEN=
# 托管模式创建云函数的候选地域，逗号分隔；至少要有 SCFPROXY_POOL_SIZE 个不同地域，建议多留一个。
# 香港机房建议选就近地域，例如 ap-guangzhou,ap-shanghai,ap-beijing。
SCFPROXY_REGIONS=ap-guangzhou,ap-shanghai,ap-beijing
# 出口池大小（含主用与备用），至少为 2；设为 3 可扩大补位期间的备用余量。
SCFPROXY_POOL_SIZE=2
# 云函数名称前缀。与 liao 等共用腾讯云账号时务必保持不同，避免两边互删/互切节点。
SCFPROXY_POOL_PREFIX=anonchat
# 单次 scfproxy CLI 操作超时（秒），默认 600。
# SCFPROXY_COMMAND_TIMEOUT_SECONDS=600
# 周期维护与失败重试间隔（秒），默认 60。
# SCFPROXY_RECONCILE_INTERVAL_SECONDS=60
# 非 Docker 部署时需要自行指定 CLI 与云函数代码包路径（镜像内已内置）。
# SCFPROXY_CLI_PATH=scfproxy
# SCFPROXY_PACKAGE_PATH=/app/scf-server.zip
